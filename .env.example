# ---------------------------------------------------------------
# Banco de dados PostgreSQL (Supabase / Neon / Vercel Postgres)
# ---------------------------------------------------------------
# DATABASE_URL: conexão usada pela aplicação (pode ser a URL "pooled").
#   Neon:     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financeiro?schema=public"

# DIRECT_URL: conexão DIRETA (sem pooler), usada apenas pelas migrações (prisma migrate).
#   Neon:     postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Em desenvolvimento local pode ser igual à DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/financeiro?schema=public"

# ---------------------------------------------------------------
# Autenticação (NextAuth / Auth.js)
# ---------------------------------------------------------------
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-forte"
# Local: http://localhost:3000   |   Produção: https://SEU-APP.vercel.app
NEXTAUTH_URL="http://localhost:3000"
