generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FamilyRole {
  HUSBAND
  WIFE
  CHILD
}

enum JoinStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShoppingStatus {
  PENDING // ainda precisa comprar
  IN_CART // alguém já pegou / está comprando
  BOUGHT // comprado (baixa na lista)
}

enum ShoppingListStatus {
  OPEN // ainda há itens a comprar
  CLOSED // 100% comprada (encerrada)
}

enum SavingsKind {
  DEPOSIT // guardei
  WITHDRAWAL // resgatei
}

enum Scope {
  PERSONAL // visível apenas para quem lançou
  FAMILY // visível para todos os membros da família
}

enum TxType {
  INCOME
  EXPENSE
}

enum TxStatus {
  PENDING // a pagar / a receber
  PAID // pago / recebido
}

enum PaymentMethod {
  PIX
  CASH
  DEBIT
  CREDIT
}

model Family {
  id               String   @id @default(cuid())
  name             String
  inviteCode       String   @unique
  emergencyReserve Decimal  @default(0) @db.Decimal(12, 2)
  ownerId          String? // usuário principal (quem criou): aprova novos membros
  createdAt        DateTime @default(now())

  members          User[]
  joinRequests     JoinRequest[]
  shoppingItems    ShoppingItem[]
  shoppingLists    ShoppingList[]
  cards            CreditCard[]
  transactions     Transaction[]
  installmentPlans InstallmentPlan[]
  recurringRules   RecurringRule[]
  savings          SavingsEntry[]
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  passwordHash     String
  emergencyReserve Decimal  @default(0) @db.Decimal(12, 2)
  role             FamilyRole? // marido, mulher ou filho
  failedLogins     Int         @default(0) // tentativas de login incorretas seguidas
  lockedAt         DateTime? // conta bloqueada (só a redefinição de senha desbloqueia)
  passwordChangedAt DateTime? // sessões emitidas antes disso deixam de valer
  awaitingApproval Boolean     @default(false) // entrou por código e ainda não foi aprovado pelo usuário principal
  createdAt        DateTime @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id])

  cards            CreditCard[]
  transactions     Transaction[]
  installmentPlans InstallmentPlan[]
  recurringRules   RecurringRule[]
  savings          SavingsEntry[]
  resetTokens      PasswordResetToken[]
  joinRequests     JoinRequest[]
  notifications    Notification[]

  @@index([familyId])
}

model CreditCard {
  id         String   @id @default(cuid())
  name       String
  limit      Decimal  @db.Decimal(12, 2)
  dueDay     Int // dia de vencimento da fatura (1-31)
  closingDay Int? // dia de fechamento (opcional)
  scope      Scope    @default(PERSONAL)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId String
  family   Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  transactions     Transaction[]
  installmentPlans InstallmentPlan[]
  recurringRules   RecurringRule[]

  @@index([userId])
  @@index([familyId])
}

// Compra parcelada: cada parcela é uma Transaction vinculada ao plano.
model InstallmentPlan {
  id                 String         @id @default(cuid())
  description        String
  totalAmount        Decimal        @db.Decimal(12, 2)
  installmentsCount  Int
  category           String
  subcategory        String?
  paymentMethod      PaymentMethod
  scope              Scope
  createdAt          DateTime       @default(now())

  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId String
  family   Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  cardId   String?
  card     CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  @@index([userId])
  @@index([familyId])
}

// Gasto/receita fixo mensal. Gera lançamentos PENDING mês a mês.
model RecurringRule {
  id            String         @id @default(cuid())
  type          TxType
  description   String
  amount        Decimal        @db.Decimal(12, 2)
  category      String
  subcategory   String?
  paymentMethod PaymentMethod?
  dayOfMonth    Int
  startMonth    String // "YYYY-MM": primeiro mês em que vale
  endMonth      String? // "YYYY-MM": último mês (vazio = sem fim)
  skipMonths    String[] @default([]) // meses excluídos individualmente (não serem regerados)
  scope         Scope
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId String
  family   Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  cardId   String?
  card     CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  @@index([userId])
  @@index([familyId])
}

model Transaction {
  id            String         @id @default(cuid())
  type          TxType
  scope         Scope
  description   String
  amount        Decimal        @db.Decimal(12, 2)
  category      String
  subcategory   String?
  date          DateTime       @db.Date // data da compra / lançamento
  dueDate       DateTime       @db.Date // vencimento (define o mês de competência)
  status        TxStatus       @default(PAID)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  createdAt     DateTime       @default(now())

  installmentNumber Int?
  recurringMonth    String? // "YYYY-MM" quando gerado por uma regra recorrente

  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId String
  family   Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  cardId   String?
  card     CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  planId   String?
  plan     InstallmentPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  ruleId   String?
  rule     RecurringRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([ruleId, recurringMonth])
  @@index([userId, dueDate])
  @@index([familyId, scope, dueDate])
  @@index([status, dueDate])
  @@index([planId])
}

// Reserva / poupança: cada linha é um aporte (DEPOSIT) ou resgate (WITHDRAWAL) em um banco.
model SavingsEntry {
  id        String       @id @default(cuid())
  kind      SavingsKind
  bank      String
  amount    Decimal      @db.Decimal(12, 2)
  date      DateTime     @db.Date
  note      String?
  scope     Scope        @default(PERSONAL)
  createdAt DateTime     @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, scope, date])
  @@index([userId, date])
}

// Link de redefinição de senha (só o hash do token é guardado).
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Limitador de tentativas (ex.: códigos de convite inválidos) por IP/usuário.
model AttemptLimit {
  key          String    @id
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
}

// Pedido para entrar em uma família (aprovado pelo usuário principal).
model JoinRequest {
  id          String     @id @default(cuid())
  status      JoinStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  decidedAt   DateTime?
  decidedById String?

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, status])
  @@index([userId, status])
}

model Notification {
  id        String    @id @default(cuid())
  type      String // JOIN_REQUEST | JOIN_APPROVED | JOIN_REJECTED | SHOPPING
  title     String
  body      String
  requestId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Lista de compras compartilhada pela família.
model ShoppingItem {
  id        String         @id @default(cuid())
  name      String
  quantity  String?
  status    ShoppingStatus @default(PENDING)
  month     String // "YYYY-MM" em que foi adicionado
  cartById  String? // quem pegou o item (para os outros não comprarem igual)
  cartAt    DateTime?
  boughtAt  DateTime?
  boughtById String?
  transactionId String? // despesa gerada na conclusão da compra
  createdById String
  createdAt DateTime       @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  listId   String
  list     ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([familyId, status])
  @@index([familyId, month])
  @@index([listId])
}

// Lista de compras: cada lista tem um código único e fica pendente até todos os itens serem comprados.
model ShoppingList {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  status      ShoppingListStatus @default(OPEN)
  createdById String
  createdAt   DateTime           @default(now())
  closedAt    DateTime?

  familyId String
  family   Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items    ShoppingItem[]

  @@index([familyId, status])
}

// Cache diário de dados externos (notícias e cotações).
model CacheEntry {
  key       String   @id
  value     Json
  fetchedAt DateTime @default(now())
}
